{
  "name": "Hello Extensions",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "logo.png"
  },
  "content_scripts": [
      {
            "matches": ["<all_urls>"],
            "css": ["libs/aos.css"],
            "js": ["libs/aos.js", "content.js"],
            "run_at": "document_idle"
      }
  ]
}